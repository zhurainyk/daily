<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/zhuyu.css">
    <title>Document</title>
</head>
<body>
    <button>返回首页</button>
    <!-- 后续功能：增加存储功能  和 计算耗时  
    如果用户输入的数字是1000000，第一次计算会耗时较长 把结果存到files/1000000.txt文件中 
    后续用户输入相同的数字 直接从文件中读取结果 -->

    <h1>因数计算</h1>
    <p>你输入的数字是：<%= num %></p>
    <ul>
        <% arr.forEach((item)=>{ %>
            <li><%= item %></li>
        <% }) %>
    </ul>
    <script>
        const button = document.querySelector('button')
        button.addEventListener('click',()=>{
            window.location.href = '/'
        })
    </script>
</body>
</html>
